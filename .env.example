# Example environment configuration for VibeCheck AI
# Copy this file to .env.local and fill in your actual API keys

OPENROUTER_API_KEY=your_openrouter_api_key_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://your_key:your_secret@your_cloud_name
RESEND_API_KEY=your_resend_api_key_here
NEXT_PUBLIC_APP_NAME="VibeCheck AI"

